# ==========================================
# AUTHENTICATION SESSION SECURITY CONFIG
# ==========================================

# For cross-subdomain applications (like your current setup)
# These settings allow seamless authentication between www.crystal-image.net and core.crystal-image.net

# Disable IP validation for cross-subdomain functionality
AUTH_SESSION_IP_VALIDATION=false

# Disable UserAgent validation for better user experience  
AUTH_SESSION_USER_AGENT_VALIDATION=false

# ==========================================
# COPY THESE TO YOUR MAIN .env FILE
# ==========================================