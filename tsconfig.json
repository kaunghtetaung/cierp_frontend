{
  "compilerOptions": {
    "target": "es2022",
    "lib": ["dom", "dom.iterable", "es2022"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@ui/*": ["./libs/ui/*"],
      "@utils/*": ["./libs/utils/*"],
      "@types/*": ["./libs/types/*"],
      "@repo/auth": ["./libs/auth"],
      "@repo/auth/*": ["./libs/auth/*"],
      "@repo/app-modules": ["./libs/appModules"],
      "@repo/app-modules/*": ["./libs/appModules/*"],
      "@repo/appSchema": ["./libs/appSchema"],
      "@repo/appSchema/*": ["./libs/appSchema/*"],
      "@repo/base-dashboard": ["./libs/baseDashboard"],
      "@repo/base-dashboard/*": ["./libs/baseDashboard/*"],
      "@repo/api": ["./libs/api"],
      "@repo/api/*": ["./libs/api/*"],
      "@repo/cache": ["./libs/cache"],
      "@repo/cache/*": ["./libs/cache/*"],
      "@repo/config": ["./libs/config/src"],
      "@repo/config/*": ["./libs/config/src/*"],
      "@repo/content": ["./libs/content"],
      "@repo/content/*": ["./libs/content/*"],
      "@repo/hooks": ["./libs/hooks"],
      "@repo/hooks/*": ["./libs/hooks/*"],
      "@repo/language": ["./libs/language"],
      "@repo/language/*": ["./libs/language/*"],
      "@repo/media": ["./libs/media"],
      "@repo/media/*": ["./libs/media/*"],
      "@repo/page": ["./libs/page"],
      "@repo/page/*": ["./libs/page/*"],
      "@repo/pdf": ["./libs/pdf"],
      "@repo/pdf/*": ["./libs/pdf/*"],
      "@repo/post": ["./libs/post"],
      "@repo/post/*": ["./libs/post/*"],
      "@repo/section": ["./libs/section"],
      "@repo/section/*": ["./libs/section/*"],
      "@repo/s3": ["./libs/s3/src"],
      "@repo/s3/*": ["./libs/s3/src/*"],
      "@repo/schema-forms": ["./libs/schema-forms"],
      "@repo/schema-forms/*": ["./libs/schema-forms/*"],
      "@repo/schema-utils": ["./libs/schema-utils"],
      "@repo/schema-utils/*": ["./libs/schema-utils/*"],
      "@repo/schema-hooks": ["./libs/schema-hooks"],
      "@repo/schema-hooks/*": ["./libs/schema-hooks/*"],
      "@repo/security": ["./libs/security"],
      "@repo/security/*": ["./libs/security/*"],
      "@repo/tenant": ["./libs/tenant"],
      "@repo/tenant/*": ["./libs/tenant/*"],
      "@repo/types": ["./libs/types"],
      "@repo/types/*": ["./libs/types/*"],
      "@repo/ui": ["./libs/ui"],
      "@repo/ui/*": ["./libs/ui/*"],
      "@repo/utils": ["./libs/utils"],
      "@repo/utils/*": ["./libs/utils/*"]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts", "apps/core/src/staticModules/content/posts/pagebackup"],
  "exclude": ["node_modules"]
}