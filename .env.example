# =================================================================
# ENVIRONMENT CONFIGURATION
# =================================================================
# Copy this file to .env and fill in your actual values
# Never commit .env files to version control

# Environment
NODE_ENV=development

# =================================================================
# REDIS CACHE CONFIGURATION
# =================================================================

# Redis Connection
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_DB=0

# =================================================================
# API & MICROSERVICES
# =================================================================

# Main API Configuration
API_GATEWAY_URL=http://localhost:3331
PORT_GATEWAY=3331
PORT_AUTH=3332

# API Gateway Authentication (optional)
API_GATEWAY_KEY=your-api-key-here
API_GATEWAY_SECRET=your-api-secret-here

# =================================================================
# AUTHENTICATION & SECURITY
# =================================================================

# OIDC Configuration (optional)
OIDC_CLIENT_ID=your-client-id
OIDC_CLIENT_SECRET=your-client-secret

# Tenant API Configuration
TENANT_API_CLIENT_ID=your-tenant-client-id
TENANT_API_CLIENT_SECRET=your-tenant-client-secret

# Auth Session Configuration
AUTH_SESSION_TIMEOUT_MINUTES=60
AUTH_SESSION_IP_VALIDATION=false
AUTH_SESSION_USER_AGENT_VALIDATION=false

# =================================================================
# MULTI-TENANT CONFIGURATION
# =================================================================

# Allowed Domains (comma-separated)
ALLOWED_DOMAINS=localhost,example.com,yourdomain.com

# Subdomain Configuration (Environment-based)
# Production uses: api, auth, www
# Development uses: api-dev, auth-dev, www-dev
API_SUBDOMAIN=api
AUTH_SUBDOMAIN=auth
WWW_SUBDOMAIN=www
NEXT_PUBLIC_API_SUBDOMAIN=api
NEXT_PUBLIC_AUTH_SUBDOMAIN=auth

# =================================================================
# NEXT.JS & FRONTEND CONFIGURATION
# =================================================================

# Next.js Public URLs
NEXT_PUBLIC_API_URL=/api

# Protocol Configuration
FORCE_HTTPS=false

# =================================================================
# ERROR REPORTING & MONITORING
# =================================================================

# Error Reporting (optional)
ERROR_REPORTING_ENDPOINT=https://your-error-endpoint.com
ERROR_REPORTING_API_KEY=your-error-api-key
NEXT_PUBLIC_ERROR_REPORTING_ENDPOINT=https://your-error-endpoint.com
NEXT_PUBLIC_BUILD_VERSION=1.0.0
