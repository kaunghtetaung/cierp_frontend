# =================================================================
# ENVIRONMENT CONFIGURATION
# =================================================================
# Copy this file to .env and fill in your actual values
# Never commit .env files to version control

# Environment
NODE_ENV=development
PORT=3000

# =================================================================
# DATABASE CONFIGURATION
# =================================================================

# Primary Database (PostgreSQL recommended)
DATABASE_URL=postgresql://username:password@localhost:5432/frontend_db
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=frontend_db
DATABASE_USER=username
DATABASE_PASSWORD=password
DATABASE_SSL=false

# Database Pool Settings
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=20
DATABASE_POOL_IDLE_TIMEOUT=30000
DATABASE_POOL_ACQUIRE_TIMEOUT=60000

# =================================================================
# REDIS CACHE CONFIGURATION
# =================================================================

# Redis Connection
REDIS_URL=redis://username:password@localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password
REDIS_DB=0

# Redis Cluster (if using cluster mode)
REDIS_CLUSTER_NODES=localhost:6379,localhost:6380,localhost:6381
REDIS_CLUSTER_PASSWORD=

# Redis Pool Settings
REDIS_POOL_MIN=5
REDIS_POOL_MAX=50
REDIS_POOL_IDLE_TIMEOUT=30000

# Cache TTL Settings (in seconds)
CACHE_TTL_DEFAULT=3600
CACHE_TTL_SESSION=86400
CACHE_TTL_TOKEN=3600
CACHE_TTL_CONTENT=1800
CACHE_TTL_TENANT=7200

# =================================================================
# API & MICROSERVICES
# =================================================================

# Main API Base URL
API_BASE_URL=http://localhost:3331
API_GATEWAY_URL=http://localhost:3331
API_TIMEOUT=30000

# API Gateway Authentication
API_GATEWAY_KEY=your-api-key-here
API_GATEWAY_SECRET=your-api-secret-here

# Internal Service URLs
USER_SERVICE_URL=http://localhost:3332
CONTENT_SERVICE_URL=http://localhost:3333
NOTIFICATION_SERVICE_URL=http://localhost:3334
UPLOAD_SERVICE_URL=http://localhost:3335

# API Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_SKIP_SUCCESSFUL_REQUESTS=true

# =================================================================
# AUTHENTICATION & SECURITY
# =================================================================

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=24h
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-this-in-production
JWT_REFRESH_EXPIRES_IN=7d

# Session Configuration
SESSION_SECRET=your-super-secret-session-key-change-this-in-production
SESSION_ENCRYPTION_KEY=your-session-encryption-key-here
SESSION_MAX_AGE=86400000
SESSION_SECURE=false
SESSION_SAME_SITE=lax
SESSION_HTTP_ONLY=true

# Auth Session Timeout (in minutes, default: 60 to match access token)
AUTH_SESSION_TIMEOUT_MINUTES=60

# Auth Session Security (set to 'true' for strict security, 'false' for flexible UX)
AUTH_SESSION_IP_VALIDATION=false
AUTH_SESSION_USER_AGENT_VALIDATION=false

# Cookie Configuration
COOKIE_SECRET=your-super-secret-cookie-key-change-this-in-production
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false
COOKIE_HTTP_ONLY=true
COOKIE_SAME_SITE=lax

# CSRF Protection
CSRF_SECRET=your-csrf-secret-here

# Password Hashing
BCRYPT_ROUNDS=12
ARGON2_MEMORY=65536
ARGON2_TIME=3
ARGON2_PARALLELISM=4

# Rate Limiting for Auth
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX_ATTEMPTS=5
AUTH_LOCKOUT_DURATION=900000

# =================================================================
# OIDC/OAuth CONFIGURATION
# =================================================================

# OIDC Provider Settings
AUTH_DOMAIN=https://auth.yourdomain.com
API_DOMAIN=https://api.yourdomain.com
OIDC_ISSUER_URL=https://your-oidc-provider.com
OIDC_CLIENT_ID=your-client-id
OIDC_CLIENT_SECRET=your-client-secret
OIDC_REDIRECT_URI=http://localhost:3000/auth/callback
OIDC_SCOPE=openid profile email

# Tenant API Configuration
TENANT_API_CLIENT_ID=your-tenant-client-id
TENANT_API_CLIENT_SECRET=your-tenant-client-secret

# OAuth Providers
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

MICROSOFT_CLIENT_ID=your-microsoft-client-id
MICROSOFT_CLIENT_SECRET=your-microsoft-client-secret

# =================================================================
# MULTI-TENANT CONFIGURATION
# =================================================================

# Default Tenant Settings
DEFAULT_TENANT_ID=default-org
DEFAULT_LANGUAGE=en
SUPPORTED_LANGUAGES=en,mm
TENANT_ISOLATION_LEVEL=strict

# Domain Configuration
ROOT_DOMAIN=localhost
ADMIN_SUBDOMAIN=admin
API_SUBDOMAIN=api
CDN_SUBDOMAIN=cdn

# Allowed Domains (comma-separated)
ALLOWED_DOMAINS=localhost,example.com,yourdomain.com

# Tenant Cache Settings
TENANT_CACHE_TTL=7200
TENANT_RESOLUTION_CACHE_TTL=300

# =================================================================
# NEXT.JS & FRONTEND CONFIGURATION
# =================================================================

# Next.js Public URLs
NEXT_PUBLIC_API_URL=/api
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_PROTOCOL=http
NEXT_PUBLIC_HOST=localhost:3000

# Protocol Configuration
FORCE_HTTPS=false

# Development Settings
USE_MOCK_USER=true
ENABLE_DEV_TOOLS=true
ENABLE_CORS=true
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
ENABLE_SWAGGER=true

# =================================================================
# FILE UPLOAD & STORAGE
# =================================================================

# Local Storage
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760
ALLOWED_FILE_TYPES=jpg,jpeg,png,gif,pdf,doc,docx,txt

# AWS S3 Configuration
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_S3_BUCKET=your-s3-bucket-name
AWS_S3_ACL=public-read

# Cloudinary Configuration
CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

# CDN Configuration
CDN_URL=https://cdn.yourdomain.com
CDN_CACHE_TTL=2592000

# =================================================================
# EMAIL CONFIGURATION
# =================================================================

# SMTP Settings
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# Email Templates
EMAIL_FROM_NAME=Your App Name
EMAIL_FROM_ADDRESS=noreply@yourdomain.com
EMAIL_REPLY_TO=support@yourdomain.com

# SendGrid Configuration
SENDGRID_API_KEY=your-sendgrid-api-key
SENDGRID_FROM_EMAIL=noreply@yourdomain.com

# Mailgun Configuration
MAILGUN_API_KEY=your-mailgun-api-key
MAILGUN_DOMAIN=yourdomain.com

# =================================================================
# LOGGING & MONITORING
# =================================================================

# Log Configuration
LOG_LEVEL=info
LOG_FORMAT=combined
LOG_DIR=./logs
LOG_MAX_SIZE=10m
LOG_MAX_FILES=14d

# Application Monitoring
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.1

# Performance Monitoring
NEW_RELIC_LICENSE_KEY=your-newrelic-license-key
NEW_RELIC_APP_NAME=frontend-app

# OpenTelemetry
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=frontend-service
OTEL_SERVICE_VERSION=1.0.0

# =================================================================
# ANALYTICS & TRACKING
# =================================================================

# Google Analytics
GA_TRACKING_ID=G-XXXXXXXXXX
GA_MEASUREMENT_ID=G-XXXXXXXXXX
NEXT_PUBLIC_GA_TRACKING_ID=G-XXXXXXXXXX

# Google Tag Manager
GTM_CONTAINER_ID=GTM-XXXXXXX
NEXT_PUBLIC_GTM_CONTAINER_ID=GTM-XXXXXXX

# Facebook Pixel
FACEBOOK_PIXEL_ID=your-facebook-pixel-id
NEXT_PUBLIC_FACEBOOK_PIXEL_ID=your-facebook-pixel-id

# Hotjar
HOTJAR_ID=your-hotjar-id
NEXT_PUBLIC_HOTJAR_ID=your-hotjar-id

# =================================================================
# SOCIAL MEDIA & INTEGRATIONS
# =================================================================

# Social Media APIs
TWITTER_API_KEY=your-twitter-api-key
TWITTER_API_SECRET=your-twitter-api-secret
TWITTER_ACCESS_TOKEN=your-twitter-access-token
TWITTER_ACCESS_TOKEN_SECRET=your-twitter-access-token-secret

FACEBOOK_APP_ID=your-facebook-app-id
FACEBOOK_APP_SECRET=your-facebook-app-secret

# =================================================================
# SEARCH & INDEXING
# =================================================================

# Elasticsearch
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_USERNAME=elastic
ELASTICSEARCH_PASSWORD=changeme
ELASTICSEARCH_INDEX_PREFIX=frontend

# Algolia
ALGOLIA_APP_ID=your-algolia-app-id
ALGOLIA_API_KEY=your-algolia-api-key
ALGOLIA_SEARCH_KEY=your-algolia-search-key
NEXT_PUBLIC_ALGOLIA_APP_ID=your-algolia-app-id
NEXT_PUBLIC_ALGOLIA_SEARCH_KEY=your-algolia-search-key

# =================================================================
# PAYMENT PROCESSING
# =================================================================

# Stripe
STRIPE_PUBLISHABLE_KEY=pk_test_your-stripe-publishable-key
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=whsec_your-stripe-webhook-secret
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your-stripe-publishable-key

# PayPal
PAYPAL_CLIENT_ID=your-paypal-client-id
PAYPAL_CLIENT_SECRET=your-paypal-client-secret
PAYPAL_MODE=sandbox
NEXT_PUBLIC_PAYPAL_CLIENT_ID=your-paypal-client-id

# =================================================================
# COMMUNICATION & MESSAGING
# =================================================================

# WebSocket Configuration
WS_PORT=3001
WS_ORIGINS=http://localhost:3000,https://yourdomain.com

# Push Notifications
VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_SUBJECT=mailto:admin@yourdomain.com
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key

# Firebase Configuration
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_PRIVATE_KEY=your-firebase-private-key
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@your-project.iam.gserviceaccount.com
NEXT_PUBLIC_FIREBASE_CONFIG={"apiKey":"your-api-key","authDomain":"your-project.firebaseapp.com","projectId":"your-project-id"}

# =================================================================
# CONTENT MANAGEMENT CONFIGURATION
# =================================================================

# Section Library Settings
SECTION_CACHE_TTL=3600
MAX_SECTIONS_PER_PAGE=50
ENABLE_SECTION_COPY=true
ENABLE_SECTION_TEMPLATES=true

# Page Library Settings
PAGE_CACHE_TTL=1800
MAX_PAGES_PER_TENANT=1000
ENABLE_PAGE_BUILDER=true
ENABLE_PAGE_TEMPLATES=true
PAGE_AUTOSAVE_INTERVAL=30000

# Post/Blog Library Settings
POST_CACHE_TTL=900
POSTS_PER_PAGE=10
ENABLE_POST_COMMENTS=true
ENABLE_POST_STATS=true
ENABLE_POST_CATEGORIES=true
ENABLE_POST_TAGS=true
POST_EXCERPT_LENGTH=160

# =================================================================
# TESTING CONFIGURATION
# =================================================================

# Testing Databases
TEST_DATABASE_URL=postgresql://username:password@localhost:5432/frontend_test_db
TEST_REDIS_URL=redis://localhost:6379/1

# Mock Services
ENABLE_MOCK_SERVICES=false
MOCK_DELAY_MS=100

# =================================================================
# FEATURE FLAGS
# =================================================================

# Authentication Features
FEATURE_USER_REGISTRATION=true
FEATURE_SOCIAL_LOGIN=true
FEATURE_EMAIL_VERIFICATION=true
FEATURE_TWO_FACTOR_AUTH=false
FEATURE_PASSWORD_RESET=true

# Content Features
FEATURE_BLOG=true
FEATURE_PAGES=true
FEATURE_SECTIONS=true
FEATURE_COMMENTS=true
FEATURE_RATINGS=true
FEATURE_SEARCH=true
FEATURE_MULTI_LANGUAGE=true

# UI Features
FEATURE_ADMIN_PANEL=true
FEATURE_PAGE_BUILDER=true
FEATURE_SECTION_BUILDER=true
FEATURE_ANALYTICS=true
FEATURE_NOTIFICATIONS=true
FEATURE_REAL_TIME_UPDATES=true
FEATURE_DARK_MODE=true

# =================================================================
# SECURITY HEADERS & POLICIES
# =================================================================

# Content Security Policy
CSP_DEFAULT_SRC=self
CSP_SCRIPT_SRC=self,unsafe-inline,unsafe-eval,*.googletagmanager.com,*.google-analytics.com
CSP_STYLE_SRC=self,unsafe-inline,*.googleapis.com
CSP_IMG_SRC=self,data:,https:,*.googletagmanager.com,*.google-analytics.com
CSP_CONNECT_SRC=self,*.google-analytics.com,*.analytics.google.com
CSP_FONT_SRC=self,*.googleapis.com,*.gstatic.com
CSP_FRAME_SRC=none

# Security Headers
HSTS_MAX_AGE=31536000
HSTS_INCLUDE_SUBDOMAINS=true
HSTS_PRELOAD=true

# =================================================================
# PERFORMANCE & OPTIMIZATION
# =================================================================

# Caching
ENABLE_RESPONSE_CACHE=true
RESPONSE_CACHE_TTL=300
ENABLE_STATIC_CACHE=true
STATIC_CACHE_TTL=86400

# Compression
ENABLE_GZIP=true
COMPRESSION_LEVEL=6
COMPRESSION_THRESHOLD=1024

# Database Optimization
DB_QUERY_TIMEOUT=30000
DB_STATEMENT_TIMEOUT=30000
DB_LOCK_TIMEOUT=30000

# Next.js Optimization
NEXT_PUBLIC_ENABLE_ANALYTICS=true
NEXT_DISABLE_STATIC_IMAGES=false

# =================================================================
# MAINTENANCE & OPERATIONS
# =================================================================

# Maintenance Mode
MAINTENANCE_MODE=false
MAINTENANCE_MESSAGE=We are currently performing scheduled maintenance.

# Health Checks
HEALTH_CHECK_INTERVAL=30000
HEALTH_CHECK_TIMEOUT=5000
HEALTH_CHECK_ENDPOINTS=/health,/ready

# Graceful Shutdown
SHUTDOWN_TIMEOUT=30000
SHUTDOWN_SIGNALS=SIGTERM,SIGINT

# =================================================================
# WEBHOOKS & INTEGRATIONS
# =================================================================

# Webhook Configuration
WEBHOOK_SECRET=your-webhook-secret
WEBHOOK_TIMEOUT=30000
WEBHOOK_RETRY_ATTEMPTS=3
WEBHOOK_RETRY_DELAY=1000

# Slack Integration
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/your/slack/webhook
SLACK_CHANNEL=#general

# Discord Integration
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your/discord/webhook

# =================================================================
# BACKUP & DISASTER RECOVERY
# =================================================================

# Backup Configuration
BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=30
BACKUP_S3_BUCKET=your-backup-bucket

# =================================================================
# LIBRARY-SPECIFIC CONFIGURATIONS
# =================================================================

# Cache Library
CACHE_PREFIX=frontend
CACHE_DEFAULT_TTL=3600
CACHE_MAX_MEMORY_USAGE=512MB

# Auth Library
AUTH_COOKIE_NAME=auth-token
AUTH_REFRESH_COOKIE_NAME=refresh-token
AUTH_SESSION_COOKIE_NAME=session-id

# Tenant Library
TENANT_HEADER_NAME=x-tenant-id
TENANT_COOKIE_NAME=tenant-id
TENANT_DEFAULT_TIMEOUT=10000

# Security Library
SECURITY_ENCRYPT_SESSIONS=true
SECURITY_ENCRYPT_COOKIES=true
SECURITY_RATE_LIMIT_ENABLED=true

# =================================================================
# ENVIRONMENT-SPECIFIC OVERRIDES
# =================================================================

# Development Only
NEXT_PUBLIC_DEV_MODE=true
NEXT_PUBLIC_MOCK_API=false
NEXT_PUBLIC_DEBUG_MODE=false

# Production Only (uncomment for production)
# FORCE_HTTPS=true
# COOKIE_SECURE=true
# SESSION_SECURE=true
# CSP_REPORT_URI=https://yourdomain.com/csp-report
# SENTRY_ENVIRONMENT=production