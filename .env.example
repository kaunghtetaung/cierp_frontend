# =================================================================
# ENVIRONMENT CONFIGURATION
# =================================================================
# Copy this file to .env and fill in your actual values
# Never commit .env files to version control

# Environment
NODE_ENV=development

# =================================================================
# REDIS CACHE CONFIGURATION
# =================================================================

# Redis Connection
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_DB=0

# =================================================================
# API & MICROSERVICES
# =================================================================

# Main API Configuration
# API_GATEWAY_URL not needed - uses dynamic URL construction from hostname
# Only set if you use bare 'localhost' without tenant domain
# API_GATEWAY_URL=http://localhost:3331
PORT_GATEWAY=3331
PORT_AUTH=3332

# API Gateway Authentication (optional)
API_GATEWAY_KEY=your-api-key-here
API_GATEWAY_SECRET=your-api-secret-here

# =================================================================
# AUTHENTICATION & SECURITY
# =================================================================

# OIDC Configuration (optional)
OIDC_CLIENT_ID=your-client-id
OIDC_CLIENT_SECRET=your-client-secret

# Tenant API Configuration
TENANT_API_CLIENT_ID=your-tenant-client-id
TENANT_API_CLIENT_SECRET=your-tenant-client-secret

# Auth Session Configuration
AUTH_SESSION_TIMEOUT_MINUTES=60
AUTH_SESSION_IP_VALIDATION=false
AUTH_SESSION_USER_AGENT_VALIDATION=false

# =================================================================
# MULTI-TENANT CONFIGURATION
# =================================================================

# Allowed Domains (comma-separated)
ALLOWED_DOMAINS=localhost,example.com,yourdomain.com

# Subdomain Configuration (Environment-based)
# Production uses: api, auth, www
# Development uses: api-dev, auth-dev, www-dev
API_SUBDOMAIN=api
AUTH_SUBDOMAIN=auth
WWW_SUBDOMAIN=www
NEXT_PUBLIC_API_SUBDOMAIN=api
NEXT_PUBLIC_AUTH_SUBDOMAIN=auth

# =================================================================
# NEXT.JS & FRONTEND CONFIGURATION
# =================================================================

# Next.js Public URLs
NEXT_PUBLIC_API_URL=/api

# Protocol Configuration
FORCE_HTTPS=false

# =================================================================
# LOGGING & MONITORING
# =================================================================

# Server-Side Logging Format for stdout → Promtail → Loki → Grafana
# 'json' for production (Loki-compatible structured logs)
# 'pretty' for development (human-readable with emojis)
LOG_FORMAT=pretty

# Client-Side Console Logger (Browser → Server → Loki)
# Auto-enabled in production, set to 'true' to enable in development
# NEXT_PUBLIC_ENABLE_CONSOLE_LOGGER=true

# =================================================================
# MINIO S3 STORAGE CONFIGURATION
# =================================================================

# MinIO Server Endpoint
# Public Reverse Proxy: 203.81.66.115:3 → storage.{tenantRootDomain}:443
# Internal MinIO Server: 192.168.200.33:9000
# Use internal URL for server-side operations from Next.js

# For server-side (Next.js API routes) - Direct internal access
MINIO_ENDPOINT=192.168.200.33
MINIO_PORT=9000
MINIO_USE_SSL=false

# For client-side (pre-signed URLs) - Public proxied URL
# Format: storage.{tenantRootDomain}
# Example: storage.tenant1.example.com
MINIO_PUBLIC_ENDPOINT_TEMPLATE=storage.{tenantRootDomain}
MINIO_PUBLIC_PORT=443
MINIO_PUBLIC_USE_SSL=true

# Region (can be any value for MinIO)
MINIO_REGION=us-east-1

# Root Access Credentials (for server-side full access)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=cidb1234

# Bucket Strategy: "per-tenant" or "shared"
# per-tenant: Each tenant gets own bucket (tenant-{tenantId})
# shared: Single bucket with tenant prefixes ({tenantId}/...)
MINIO_BUCKET_STRATEGY=per-tenant
