# =================================================================
# OPTIMIZED Single-Stage Dockerfile for PublicWeb Frontend
# Preserves pnpm workspace symlinks + adds optimizations
# =================================================================

FROM node:22-alpine
WORKDIR /app

# Proxy support (optional build args)
ARG HTTP_PROXY
ARG HTTPS_PROXY
ARG NO_PROXY
ENV HTTP_PROXY=${HTTP_PROXY} \
    HTTPS_PROXY=${HTTPS_PROXY} \
    NO_PROXY=${NO_PROXY} \
    http_proxy=${HTTP_PROXY} \
    https_proxy=${HTTPS_PROXY} \
    no_proxy=${NO_PROXY}

# Use Thailand mirror for Alpine packages (Myanmar ISP blocks default)
RUN sed -i 's|https://dl-cdn.alpinelinux.org|https://mirror.kku.ac.th|g' /etc/apk/repositories

# Install build tools and runtime dependencies
RUN apk add --no-cache python3 make g++ libc6-compat dumb-init

# Install pnpm
RUN corepack enable && corepack prepare pnpm@10.13.1 --activate

# Copy everything - maintains workspace structure
COPY . .

# Configure pnpm for faster installs and proxy reliability
RUN pnpm config set store-dir /root/.pnpm-store && \
    pnpm config set network-timeout 300000 && \
    pnpm config set fetch-retries 5 && \
    pnpm config set fetch-retry-mintimeout 20000 && \
    pnpm config set fetch-retry-maxtimeout 120000

# CRITICAL: Install dependencies IN PLACE
# This preserves pnpm workspace symlinks for @repo/* packages
RUN pnpm install --frozen-lockfile --force

# Build the application - workspace packages will resolve correctly
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1

WORKDIR /app/apps/publicWeb
RUN --mount=type=cache,target=/app/apps/publicWeb/.next/cache \
    pnpm build

# Go back to app root for runtime
WORKDIR /app

# Create non-root user
RUN addgroup -g 1001 -S nodejs && adduser -S nextjs -u 1001

# Since Next.js is built with standalone, we need to prepare the runtime
# The standalone folder contains everything needed to run
RUN mkdir -p /app/runtime && \
    cp -r /app/apps/publicWeb/.next/standalone/* /app/runtime/ && \
    cp -r /app/apps/publicWeb/.next/static /app/runtime/apps/publicWeb/.next/static && \
    cp -r /app/apps/publicWeb/public /app/runtime/apps/publicWeb/public && \
    chown -R nextjs:nodejs /app/runtime

# Set runtime directory
WORKDIR /app/runtime

# Production environment
ENV NODE_ENV=production
ENV PORT=3002
ENV HOSTNAME="0.0.0.0"
ENV NEXT_TELEMETRY_DISABLED=1

# Redis config (overridden by K8s)
ENV REDIS_HOST=192.168.200.32
ENV REDIS_PORT=6379
ENV REDIS_USERNAME=cidbaccess
ENV REDIS_PASSWORD=cidb1234
ENV API_SUBDOMAIN=api
ENV AUTH_SUBDOMAIN=auth
ENV NEXT_PUBLIC_API_SUBDOMAIN=api
ENV NEXT_PUBLIC_AUTH_SUBDOMAIN=auth

USER nextjs
EXPOSE 3002

HEALTHCHECK --interval=30s --timeout=3s --start-period=40s --retries=3 \
  CMD node -e "require('http').get('http://localhost:3002/api/health', (r) => { process.exit(r.statusCode === 200 ? 0 : 1); }).on('error', () => process.exit(1))"

ENTRYPOINT ["dumb-init", "--"]
CMD ["node", "apps/publicWeb/server.js"]
