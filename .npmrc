# NPM Configuration for Frontend Monorepo

# Use legacy peer dependencies to resolve React 19 compatibility issues
legacy-peer-deps=true

# Optional: Set registry (uncomment if needed)
# registry=https://registry.npmjs.org/

# Optional: Set cache location (uncomment if needed)
# cache=/home/ciadmin/.npm-cache

# Strict SSL (set to false only if behind corporate proxy)
strict-ssl=true

# Fetch retries
fetch-retries=3
fetch-retry-mintimeout=10000
fetch-retry-maxtimeout=60000

# Network timeout
network-timeout=60000

# Save exact versions
save-exact=false

# Progress bar
progress=true