"use client";

import React from "react";
import { useFormContext, useFieldArray } from "react-hook-form";
import { Button } from "@repo/ui";
import { IconComponent } from "@repo/ui";

export function AcademicInfoStep() {
  const { register, control, formState: { errors } } = useFormContext();

  const {
    fields: batchFields,
    append: appendBatch,
    remove: removeBatch,
  } = useFieldArray({
    control,
    name: "batches",
  });

  const {
    fields: educationFields,
    append: appendEducation,
    remove: removeEducation,
  } = useFieldArray({
    control,
    name: "previousEducation",
  });

  const inputClass =
    "block w-full px-3 py-2 text-sm border border-gray-300 rounded-md bg-white text-gray-900 placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-all";
  const labelClass =
    "block text-sm font-medium text-gray-700 mb-1.5";
  const errorClass = "text-xs text-red-600 mt-1";

  return (
    <div className="space-y-8">
      {/* Basic Academic Information */}
      <div>
        <h3 className="text-lg font-semibold text-gray-900 mb-4">
          Basic Academic Information
        </h3>
        <div className="grid md:grid-cols-2 gap-6">
          <div>
            <label className={labelClass}>MEDM Number (Optional)</label>
            <input
              {...register("medmNumber")}
              type="text"
              className={inputClass}
            />
          </div>
          <div>
            <label className={labelClass}>Hobbies</label>
            <input
              {...register("hobbies")}
              type="text"
              className={inputClass}
              placeholder="e.g., Reading, Sports"
            />
          </div>
          <div>
            <label className={labelClass}>Skills</label>
            <input
              {...register("skills")}
              type="text"
              className={inputClass}
              placeholder="e.g., Programming, Music"
            />
          </div>
          <div>
            <label className={labelClass}>Disabilities (if any)</label>
            <input
              {...register("disabilities")}
              type="text"
              className={inputClass}
            />
          </div>
          <div>
            <label className={labelClass}>Medical Conditions (if any)</label>
            <input
              {...register("medicalConditions")}
              type="text"
              className={inputClass}
            />
          </div>
          <div>
            <label className={labelClass}>Special Requirements</label>
            <input
              {...register("specialRequirements")}
              type="text"
              className={inputClass}
            />
          </div>
        </div>
      </div>

      {/* Batch Enrollment */}
      <div>
        <div className="flex items-center justify-between mb-4">
          <h3 className="text-lg font-semibold text-gray-900">
            Batch Enrollment
          </h3>
          <Button
            type="button"
            onClick={() =>
              appendBatch({
                batchId: "",
                academicYearId: "",
                rollNo: "",
                subjects: [],
              })
            }
            variant="outline"
            size="sm"
          >
            <IconComponent name="Plus" className="w-4 h-4 mr-2" />
            Add Batch
          </Button>
        </div>

        <div className="space-y-4">
          {batchFields.map((field: any, index: number) => (
            <div
              key={field.id}
              className="border border-gray-300 rounded-lg p-4"
            >
              <div className="flex items-center justify-between mb-4">
                <h4 className="text-base font-medium text-gray-900">
                  Batch #{index + 1}
                </h4>
                <Button
                  type="button"
                  onClick={() => removeBatch(index)}
                  variant="destructive"
                  size="sm"
                >
                  <IconComponent name="Trash2" className="w-4 h-4 mr-2" />
                  Remove
                </Button>
              </div>

              <div className="grid md:grid-cols-3 gap-4">
                <div>
                  <label className={labelClass}>Academic Year ID</label>
                  <input
                    {...register(`batches.${index}.academicYearId`)}
                    type="text"
                    className={inputClass}
                  />
                </div>
                <div>
                  <label className={labelClass}>Batch ID</label>
                  <input
                    {...register(`batches.${index}.batchId`)}
                    type="text"
                    className={inputClass}
                  />
                </div>
                <div>
                  <label className={labelClass}>Roll Number</label>
                  <input
                    {...register(`batches.${index}.rollNo`)}
                    type="text"
                    className={inputClass}
                  />
                </div>
              </div>
            </div>
          ))}
          {batchFields.length === 0 && (
            <p className="text-gray-500 text-center py-4">
              No batches added yet. Click "Add Batch" to get started.
            </p>
          )}
        </div>
      </div>

      {/* Previous Education */}
      <div>
        <div className="flex items-center justify-between mb-4">
          <h3 className="text-lg font-semibold text-gray-900">
            Previous Education
          </h3>
          <Button
            type="button"
            onClick={() =>
              appendEducation({
                className: "",
                rollNumber: "",
                examBoard: "",
                totalMarks: "",
                year: "",
                subjects: [],
              })
            }
            variant="outline"
            size="sm"
          >
            <IconComponent name="Plus" className="w-4 h-4 mr-2" />
            Add Education Record
          </Button>
        </div>

        <div className="space-y-4">
          {educationFields.map((field: any, index: number) => (
            <div
              key={field.id}
              className="border border-gray-300 rounded-lg p-4"
            >
              <div className="flex items-center justify-between mb-4">
                <h4 className="text-base font-medium text-gray-900">
                  Education Record #{index + 1}
                </h4>
                <Button
                  type="button"
                  onClick={() => removeEducation(index)}
                  variant="destructive"
                  size="sm"
                >
                  <IconComponent name="Trash2" className="w-4 h-4 mr-2" />
                  Remove
                </Button>
              </div>

              <div className="grid md:grid-cols-2 gap-4">
                <div>
                  <label className={labelClass}>Class Name</label>
                  <input
                    {...register(`previousEducation.${index}.className`)}
                    type="text"
                    className={inputClass}
                  />
                </div>
                <div>
                  <label className={labelClass}>Roll Number</label>
                  <input
                    {...register(`previousEducation.${index}.rollNumber`)}
                    type="text"
                    className={inputClass}
                  />
                </div>
                <div>
                  <label className={labelClass}>Exam Board</label>
                  <input
                    {...register(`previousEducation.${index}.examBoard`)}
                    type="text"
                    className={inputClass}
                  />
                </div>
                <div>
                  <label className={labelClass}>Total Marks</label>
                  <input
                    {...register(`previousEducation.${index}.totalMarks`)}
                    type="text"
                    className={inputClass}
                  />
                </div>
                <div>
                  <label className={labelClass}>Year</label>
                  <input
                    {...register(`previousEducation.${index}.year`)}
                    type="text"
                    className={inputClass}
                  />
                </div>
              </div>
            </div>
          ))}
          {educationFields.length === 0 && (
            <p className="text-gray-500 text-center py-4">
              No education records added yet. Click "Add Education Record" to
              get started.
            </p>
          )}
        </div>
      </div>
    </div>
  );
}
