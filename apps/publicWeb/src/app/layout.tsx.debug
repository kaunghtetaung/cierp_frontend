import { headers } from "next/headers";
import { getTenantSetting } from "@repo/tenant/tenant-service";

/**
 * Debug Layout for Tenant Initialization Testing
 * Shows the complete flow of tenant initialization and settings loading
 */

async function getTenantDebugInfo() {
  try {
    // 1. Get tenant ID from headers (set by middleware)
    const headerStore = await headers();
    const tenantId = headerStore.get("x-tenant-id");
    const appId = headerStore.get("x-app-id");
    const language = headerStore.get("x-lang");
    
    console.log("🔍 DEBUG Layout - Headers received:", {
      tenantId,
      appId,
      language
    });

    if (!tenantId) {
      return {
        error: "No tenant ID in headers - middleware may have failed",
        headers: {
          tenantId: null,
          appId,
          language
        }
      };
    }

    // 2. Skip tenant settings fetch to avoid timeout - just show we have the ID
    console.log("🔍 DEBUG Layout - Tenant ID available:", tenantId);
    const tenantSettings = { 
      id: tenantId, 
      note: "Settings fetch skipped to avoid timeout" 
    };
    
    // 3. Check token status (simplified without direct imports)
    let tokenInfo = {
      hasInitializer: false,
      hasTenant: false,
      hasUser: false,
      initializerExpiry: null as string | null,
      tenantExpiry: null as string | null
    };
    
    try {
      // Use require to avoid build issues with auth module
      const authPath = require.resolve("@repo/auth");
      const authDir = authPath.replace(/\/dist\/.*|\/src\/.*|\/index\..*/, '');
      const { getTokenMetadata, getInitializerTokenData, getTenantTokenData } = require(`${authDir}/src/core/tokens`);
      
      const tokenMetadata = await getTokenMetadata(tenantId);
      const initializerToken = await getInitializerTokenData();
      const tenantToken = await getTenantTokenData(tenantId);
      
      tokenInfo = {
        hasInitializer: tokenMetadata.hasInitializer,
        hasTenant: tokenMetadata.hasTenant,
        hasUser: tokenMetadata.hasUser,
        initializerExpiry: initializerToken ? new Date(initializerToken.expiresAt * 1000).toISOString() : null,
        tenantExpiry: tenantToken ? new Date(tenantToken.expiresAt * 1000).toISOString() : null
      };
    } catch (error) {
      console.log("Token check skipped - module not available");
      // Provide simplified token info
      tokenInfo = {
        hasInitializer: false,
        hasTenant: false,
        hasUser: false,
        initializerExpiry: null,
        tenantExpiry: null
      };
    }
    
    // 4. Skip Redis check to avoid timeout
    let redisStatus = "skipped - avoiding timeout";
    let cachedSettings = null;

    return {
      success: true,
      headers: {
        tenantId,
        appId,
        language
      },
      tenant: {
        id: tenantSettings.id,
        name: (tenantSettings as any).name || "N/A",
        domain: (tenantSettings as any).domain || "N/A",
        // Don't expose secrets
        hasSettings: true
      },
      tokens: tokenInfo,
      cache: {
        status: redisStatus,
        hasSettings: !!cachedSettings
      }
    };
  } catch (error) {
    console.error("🔥 DEBUG Layout - Error:", error);
    return {
      error: error instanceof Error ? error.message : String(error),
      stack: error instanceof Error ? error.stack : undefined
    };
  }
}

async function RedisTestComponent() {
  // Skip Redis tests to avoid timeout issues
  return {
    connection: "skipped",
    writeTest: "skipped",
    readTest: "skipped", 
    deleteTest: "skipped",
    note: "Tests skipped to avoid timeout - use /redis page for interactive testing"
  };
}

export default async function RootLayout({
  children,
}: {
  children: React.ReactNode;
}) {
  const debugInfo = await getTenantDebugInfo();
  const redisTests = await RedisTestComponent();
  
  return (
    <html lang="en">
      <body>
        {/* Debug Panel */}
        <div style={{
          background: '#1a1a1a',
          color: '#00ff00',
          padding: '20px',
          fontFamily: 'monospace',
          fontSize: '12px',
          borderBottom: '2px solid #00ff00',
          maxHeight: '400px',
          overflow: 'auto'
        }}>
          <h2 style={{ margin: '0 0 10px 0', color: '#00ff00' }}>
            🔍 Tenant Debug Panel - PublicWeb
          </h2>
          
          <div style={{ display: 'grid', gridTemplateColumns: '1fr 1fr', gap: '20px' }}>
            {/* Left Column - Tenant Info */}
            <div>
              <h3 style={{ color: '#ffff00' }}>📋 Tenant Initialization</h3>
              <pre style={{ 
                background: '#000',
                padding: '10px',
                borderRadius: '4px',
                whiteSpace: 'pre-wrap',
                wordBreak: 'break-all'
              }}>
{JSON.stringify(debugInfo, null, 2)}
              </pre>
            </div>
            
            {/* Right Column - Redis Tests */}
            <div>
              <h3 style={{ color: '#ffff00' }}>🔧 Redis Tests</h3>
              <pre style={{ 
                background: '#000',
                padding: '10px',
                borderRadius: '4px',
                whiteSpace: 'pre-wrap',
                wordBreak: 'break-all'
              }}>
{JSON.stringify(redisTests, null, 2)}
              </pre>
              
              <h3 style={{ color: '#ffff00' }}>📝 Flow Summary</h3>
              <ol style={{ color: '#00ff00', lineHeight: '1.6' }}>
                <li>Middleware resolves tenant from domain/cookie</li>
                <li>Middleware sets x-tenant-id header</li>
                <li>Layout receives tenant ID from headers</li>
                <li>getTenantSetting() loads settings:</li>
                <ul>
                  <li>→ Checks Redis cache (1s timeout)</li>
                  <li>→ Falls back to API if cache miss</li>
                  <li>→ API call uses token hierarchy:</li>
                  <ul>
                    <li>• User Token (if available)</li>
                    <li>• Tenant Token (if available)</li>
                    <li>• Initializer Token (auto-refresh)</li>
                  </ul>
                </ul>
                <li>Settings cached in Redis for future use</li>
              </ol>
              
              <div style={{ marginTop: '10px', padding: '10px', background: '#222', borderRadius: '4px' }}>
                <strong style={{ color: '#ffff00' }}>Quick Links:</strong>
                <div style={{ marginTop: '5px' }}>
                  <a href="/redis" style={{ color: '#00ffff', marginRight: '15px' }}>→ Redis Test Page</a>
                  <a href="/api/redis/test" style={{ color: '#00ffff' }}>→ Redis API Test</a>
                </div>
              </div>
            </div>
          </div>
        </div>
        
        {/* Main Content */}
        <div style={{ minHeight: 'calc(100vh - 440px)' }}>
          {children}
        </div>
      </body>
    </html>
  );
}