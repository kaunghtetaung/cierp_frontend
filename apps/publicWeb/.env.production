# Environment
NODE_ENV=production
PORT=3000

# =================================================================
# CONFIG SERVICE CONFIGURATION
# =================================================================
# Enable hot-reload from config service in production
ENABLE_CONFIG_HOT_RELOAD=true
CONFIG_SERVICE_URL=http://config.ciapp-backend.svc.cluster.local:3330
CONFIG_SERVICE_APP_NAME=publicWeb
CONFIG_SERVICE_ENVIRONMENT=production
CONFIG_REFRESH_INTERVAL=300000
CONFIG_DEBUG=false

# =================================================================
# RUNTIME CONFIGURATION FALLBACKS
# =================================================================
# These are fallback values used when config service is unavailable

# OIDC Configuration for InitializerToken (PRODUCTION)
TENANT_API_CLIENT_ID=f63672873ab7908f14f889c9a4d1b0747b8036257aa08c3568f5b1aa102f75d2
TENANT_API_CLIENT_SECRET=T7uAqmC0utEiQO4ifCDvlnscjFTxaV8/XLPngmA7phCCif8mZy25MrTTu9OaDRPs

# Redis Connection - Production fallback
REDIS_HOST=192.168.200.32
REDIS_PORT=6379
REDIS_PASSWORD=cidb1234
REDIS_USERNAME=cidbaccess
REDIS_DB=0

# Cache TTL Settings (in seconds)
CACHE_TTL_DEFAULT=3600
CACHE_TTL_TENANT_SETTINGS=1800
CACHE_TTL_USER_SESSION=7200
CACHE_TTL_AUTH_TOKEN=900
CACHE_TTL_CONTENT=600

# Logging Configuration
LOG_FORMAT=json
NEXT_PUBLIC_ENABLE_CONSOLE_LOGGER='false'

# MinIO/S3 Configuration - Production fallback
MINIO_ENDPOINT=192.168.200.33
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_REGION=us-east-1
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=cidb1234
MINIO_BUCKET_STRATEGY=per-tenant
MINIO_PUBLIC_ENDPOINT_TEMPLATE=storage.{tenantRootDomain}
MINIO_PUBLIC_PORT=443
MINIO_PUBLIC_USE_SSL=true

# API Subdomains - Production fallback
API_SUBDOMAIN=api
AUTH_SUBDOMAIN=auth
NEXT_PUBLIC_API_SUBDOMAIN=api
NEXT_PUBLIC_AUTH_SUBDOMAIN=auth

# =================================================================
# NEXT.JS CONFIGURATION
# =================================================================

# Next.js specific
NEXT_PUBLIC_APP_URL=https://www.um1ygn.edu.mm

# =================================================================
# PDF WATERMARK SERVICE
# =================================================================
# PDF Service URL for watermarking private PDFs
PDF_SERVICE_URL=http://pdf-service.ciapp-backend.svc.cluster.local:3338
PDF_SERVICE_TIMEOUT=30000
