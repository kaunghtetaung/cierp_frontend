# =================================================================
# DEVELOPMENT ENVIRONMENT CONFIGURATION
# =================================================================
# This file contains safe defaults for development
# Copy relevant values to your .env file

# Environment
NODE_ENV=development

# Redis Cache (Update with your Redis instance)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_DB=0

# API Configuration
API_GATEWAY_URL=http://localhost:3331
PORT_GATEWAY=3331
PORT_AUTH=3332

# API Gateway Authentication (optional)
API_GATEWAY_KEY=
API_GATEWAY_SECRET=

# OIDC Configuration (optional for development)
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=

# Tenant API Configuration
TENANT_API_CLIENT_ID=
TENANT_API_CLIENT_SECRET=

# Multi-Tenant Configuration
ALLOWED_DOMAINS=localhost,127.0.0.1

# Subdomain Configuration
API_SUBDOMAIN=api
AUTH_SUBDOMAIN=auth
WWW_SUBDOMAIN=www
NEXT_PUBLIC_API_SUBDOMAIN=api
NEXT_PUBLIC_AUTH_SUBDOMAIN=auth

# Next.js Configuration
NEXT_PUBLIC_API_URL=/api
FORCE_HTTPS=false

# Auth Session Configuration
AUTH_SESSION_TIMEOUT_MINUTES=60
AUTH_SESSION_IP_VALIDATION=false
AUTH_SESSION_USER_AGENT_VALIDATION=false

# Error Reporting (optional)
ERROR_REPORTING_ENDPOINT=
ERROR_REPORTING_API_KEY=
NEXT_PUBLIC_ERROR_REPORTING_ENDPOINT=
NEXT_PUBLIC_BUILD_VERSION=