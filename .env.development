# =================================================================
# DEVELOPMENT ENVIRONMENT CONFIGURATION
# =================================================================
# This file contains safe defaults for development
# Copy relevant values to your .env file

# Environment
NODE_ENV=development
PORT=3000

# Database (Update with your actual database)
DATABASE_URL=postgresql://postgres:password@localhost:5432/frontend_dev
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=frontend_dev
DATABASE_USER=postgres
DATABASE_PASSWORD=password
DATABASE_SSL=false

# Redis Cache (Update with your Redis instance)
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# API Configuration
# Removed: API_BASE_URL (use API_GATEWAY_URL instead)
API_GATEWAY_URL=http://localhost:3331
API_TIMEOUT=30000

# Development Secrets (CHANGE THESE IN PRODUCTION!)
JWT_SECRET=dev-jwt-secret-please-change-in-production-environment
JWT_REFRESH_SECRET=dev-refresh-secret-please-change-in-production-environment
SESSION_SECRET=dev-session-secret-please-change-in-production-environment
SESSION_ENCRYPTION_KEY=dev-encryption-key-please-change-in-production-environment
COOKIE_SECRET=dev-cookie-secret-please-change-in-production-environment
CSRF_SECRET=dev-csrf-secret-please-change-in-production-environment

# Multi-Tenant Configuration
DEFAULT_LANGUAGE=en
SUPPORTED_LANGUAGES=en,mm
ROOT_DOMAIN=localhost
ALLOWED_DOMAINS=localhost,127.0.0.1

# Next.js Configuration
NEXT_PUBLIC_API_URL=/api
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_PROTOCOL=http
NEXT_PUBLIC_HOST=localhost:3000

# Development Features
USE_MOCK_USER=true
ENABLE_DEV_TOOLS=true
ENABLE_CORS=true
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
FORCE_HTTPS=false

# Security (Development - Less Restrictive)
COOKIE_SECURE=false
SESSION_SECURE=false
SESSION_HTTP_ONLY=true
COOKIE_HTTP_ONLY=true
SESSION_SAME_SITE=lax
COOKIE_SAME_SITE=lax

# Cache TTL Settings (in seconds)
CACHE_TTL_DEFAULT=3600
CACHE_TTL_SESSION=86400
CACHE_TTL_TOKEN=3600
CACHE_TTL_CONTENT=1800
CACHE_TTL_TENANT=7200

# Content Management (Development Defaults)
SECTION_CACHE_TTL=3600
MAX_SECTIONS_PER_PAGE=50
ENABLE_SECTION_COPY=true
ENABLE_SECTION_TEMPLATES=true

PAGE_CACHE_TTL=1800
MAX_PAGES_PER_TENANT=1000
ENABLE_PAGE_BUILDER=true
ENABLE_PAGE_TEMPLATES=true
PAGE_AUTOSAVE_INTERVAL=30000

POST_CACHE_TTL=900
POSTS_PER_PAGE=10
ENABLE_POST_COMMENTS=true
ENABLE_POST_STATS=true
ENABLE_POST_CATEGORIES=true
ENABLE_POST_TAGS=true
POST_EXCERPT_LENGTH=160

# Feature Flags (Development - Most Features Enabled)
FEATURE_USER_REGISTRATION=true
FEATURE_SOCIAL_LOGIN=true
FEATURE_EMAIL_VERIFICATION=false
FEATURE_TWO_FACTOR_AUTH=false
FEATURE_PASSWORD_RESET=true

FEATURE_BLOG=true
FEATURE_PAGES=true
FEATURE_SECTIONS=true
FEATURE_COMMENTS=true
FEATURE_RATINGS=true
FEATURE_SEARCH=true
FEATURE_MULTI_LANGUAGE=true

FEATURE_ADMIN_PANEL=true
FEATURE_PAGE_BUILDER=true
FEATURE_SECTION_BUILDER=true
FEATURE_ANALYTICS=false
FEATURE_NOTIFICATIONS=true
FEATURE_REAL_TIME_UPDATES=true
FEATURE_DARK_MODE=true

# File Upload (Local Development)
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760
ALLOWED_FILE_TYPES=jpg,jpeg,png,gif,pdf,doc,docx,txt

# Email (Development - Console Output)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
EMAIL_FROM_NAME=Frontend Dev
EMAIL_FROM_ADDRESS=dev@localhost

# Logging (Development)
LOG_LEVEL=debug
LOG_FORMAT=dev
LOG_DIR=./logs

# Testing Configuration
TEST_DATABASE_URL=postgresql://postgres:password@localhost:5432/frontend_test
TEST_REDIS_URL=redis://localhost:6379/1
ENABLE_MOCK_SERVICES=true
MOCK_DELAY_MS=100

# Library-Specific Development Settings
CACHE_PREFIX=frontend-dev
AUTH_COOKIE_NAME=auth-token
AUTH_REFRESH_COOKIE_NAME=refresh-token
AUTH_SESSION_COOKIE_NAME=session-id
TENANT_HEADER_NAME=x-tenant-id
TENANT_COOKIE_NAME=tenant-id

# Performance (Development - Less Restrictive)
ENABLE_RESPONSE_CACHE=true
RESPONSE_CACHE_TTL=60
ENABLE_STATIC_CACHE=true
STATIC_CACHE_TTL=300

# Development Only
NEXT_PUBLIC_DEV_MODE=true
NEXT_PUBLIC_MOCK_API=false
NEXT_PUBLIC_DEBUG_MODE=true